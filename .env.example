# docker compose 的变量文件模板
#
#   cp .env.example .env
#   # 编辑 .env 填好下面三项
#   docker compose up -d --build
#
# .env 已被 .gitignore 忽略，不会提交到仓库。

# ---- MySQL ----
# root 密码：只用于容器内健康检查和运维，应用不用它连库
DB_ROOT_PASSWORD=change-me-root

# 应用账号 talkai 的密码：首次初始化数据卷时自动创建该账号，
# 并只授予 spring_ai_test 库的权限（比用 root 连库安全）
DB_PASSWORD=change-me-app

# ---- DeepSeek（必填）----
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- 阿里云 Voice Studio TTS（必填）----
TTS_ALIYUN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TTS_ALIYUN_VOICE_ID=5626beba-35b5-4807-97cf-bcb06584e918

# ---- 可选 ----
# 国内网络构建慢时取消注释，加速 Maven / npm 依赖下载
# MAVEN_MIRROR_URL=https://maven.aliyun.com/repository/public
# NPM_REGISTRY=https://registry.npmmirror.com

# 对外暴露的端口，默认 80；改成 8080 就访问 http://<服务器IP>:8080/
# HTTP_PORT=80
# JVM 内存上限，默认按容器可用内存的 75%
# JAVA_OPTS=-XX:MaxRAMPercentage=75
# 允许的跨域来源，同域部署（Nginx 反代）时保持 * 即可，也可收紧成你的域名
# APP_CORS_ALLOWED_ORIGINS=*

# 复制为 backend/.env 后填入真实值。
# .env 已被 .gitignore 忽略，不会提交到版本库。
# 本地开发：直接放在 backend/ 目录下即可（工作目录为 backend 时自动加载）。
# 生产环境：推荐用真实环境变量注入，而不是这个文件。

# ---- 数据库 ----
# allowPublicKeyRetrieval=true 是必须的：MySQL 8 默认 caching_sha2_password，
# useSSL=false 时不加这个参数会直接报 "Public Key Retrieval is not allowed"。
DB_URL=jdbc:mysql://localhost:3306/spring_ai_test?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=

# ---- DeepSeek ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- 语音合成：默认 Fish Audio，原阿里云 Voice Studio 保留为回退 ----
TTS_PROVIDER=fish
TTS_FALLBACK_PROVIDER=aliyun
TTS_FISH_API_KEY=
TTS_FISH_REFERENCE_ID=
TTS_FISH_MODEL=drama-3
# 仅在运行后端的机器无法直连 api.fish.audio 时填写。
TTS_FISH_PROXY_HOST=
TTS_FISH_PROXY_PORT=0

# 可选的旧提供方。配置后 Fish Audio 临时不可用时自动回退。
TTS_ALIYUN_API_KEY=
TTS_ALIYUN_VOICE_ID=

# ---- 阿里云百炼：Qwen-ASR 语音识别 ----
DASHSCOPE_API_KEY=
DASHSCOPE_CHAT_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
ASR_ALIYUN_MODEL=qwen3-asr-flash

# 实时通话：留空自动沿用 DASHSCOPE_CHAT_URL 的域名，也可配置业务空间专属 wss 地址。
VOICE_ASR_URL=
VOICE_ASR_MODEL=qwen3-asr-flash-realtime
VOICE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://tauri.localhost,tauri://localhost

# 截图理解复用上方 DEEPSEEK_API_KEY
VISION_DEEPSEEK_MODEL=deepseek-flash

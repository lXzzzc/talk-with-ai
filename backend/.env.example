# 复制为 backend/.env 后填入真实值。
# .env 已被 .gitignore 忽略，不会提交到版本库。
# 本地开发：直接放在 backend/ 目录下即可（工作目录为 backend 时自动加载）。
# 生产环境：推荐用真实环境变量注入，而不是这个文件。

# ---- 数据库 ----
DB_URL=jdbc:mysql://localhost:3306/spring_ai_test?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=

# ---- DeepSeek ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
